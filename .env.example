# Mimir MCP gateway
MCP_HOST=0.0.0.0
MCP_PORT=8787
MCP_ALLOWED_HOSTS=localhost,127.0.0.1
MCP_AUTH_TOKEN=replace-with-at-least-24-random-characters

# Gateway -> n8n
N8N_BASE_URL=http://n8n:5678
N8N_WEBHOOK_TOKEN=replace-with-a-different-random-secret
N8N_TIMEOUT_MS=120000

# n8n -> repo scanner
SCANNER_AUTH_TOKEN=replace-with-a-third-random-secret
SCANNER_HOST=0.0.0.0
SCANNER_PORT=8790
SCANNER_TIMEOUT_MS=120000
SCANNER_GIT_DEPTH=80
SCANNER_MAX_FILES=180
SCANNER_MAX_FILE_BYTES=262144
SCANNER_MAX_TOTAL_BYTES=4194304

# Optional. Required to scan private GitHub repositories and useful for rate limits.
GITHUB_TOKEN=

# n8n
N8N_ENCRYPTION_KEY=replace-with-a-fourth-random-secret
N8N_IMAGE=docker.n8n.io/n8nio/n8n:latest
