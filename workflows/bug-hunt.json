{
  "name": "Mimir · Bug Hunt",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "mimir/bug-hunt",
        "authentication": "headerAuth",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "bug-hunt-webhook",
      "name": "Mimir Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [
        -900,
        0
      ],
      "webhookId": "mimir-bug-hunt",
      "credentials": {
        "httpHeaderAuth": {
          "id": "MIMIR_WEBHOOK_AUTH",
          "name": "Mimir Webhook Auth"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://repo-scanner:8790/scan",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify({ repository: $('Mimir Webhook').item.json.body.repository, ref: $('Mimir Webhook').item.json.body.ref ?? 'main' }) }}",
        "options": {
          "timeout": 120000
        }
      },
      "id": "bug-hunt-scanner",
      "name": "Scan Repository",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -620,
        0
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "MIMIR_SCANNER_AUTH",
          "name": "Mimir Scanner Auth"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://agent-runner:8791/analyze",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify({ kind: 'bug-hunt', input: $('Mimir Webhook').item.json.body ?? {}, scan: $('Scan Repository').item.json }) }}",
        "options": {
          "timeout": 120000
        }
      },
      "id": "bug-hunt-agent",
      "name": "Run Agent Analysis",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -340,
        0
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "MIMIR_AGENT_AUTH",
          "name": "Mimir Agent Auth"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const scan = $('Scan Repository').item.json;\nconst agent = $json;\nconst input = $('Mimir Webhook').item.json.body ?? {};\nconst order = { low: 0, medium: 1, high: 2, critical: 3 };\nconst minimum = input.minimum_severity ?? 'medium';\nconst findings = (scan.findings ?? []).filter(\n  (finding) => (order[finding.severity] ?? 0) >= (order[minimum] ?? 1)\n);\n\nreturn [{\n  json: {\n    status: 'completed',\n    workflow: 'bug-hunt',\n    run_id: String($execution.id),\n    contract_version: 3,\n    repository: scan.repository,\n    requested_ref: scan.requested_ref,\n    commit: scan.commit,\n    summary: {\n      ...scan.findings_summary,\n      returned_findings: findings.length,\n      analyzed_files: scan.inventory?.analyzed_files ?? 0,\n      analyzed_bytes: scan.inventory?.analyzed_bytes ?? 0,\n      truncated: scan.inventory?.truncated ?? false\n    },\n    deterministic_findings: findings.slice(0, 100),\n    agent_analysis: {\n      configured: Boolean(agent.configured),\n      mode: agent.mode ?? 'unknown',\n      model: agent.model ?? null,\n      latency_ms: agent.latency_ms ?? null,\n      analysis: agent.analysis ?? null,\n      error: agent.error ?? null,\n      usage: agent.usage ?? null\n    },\n    hotspots: (scan.hotspots ?? []).slice(0, 15),\n    largest_files: (scan.largest_files ?? []).slice(0, 15),\n    languages: scan.languages ?? []\n  }\n}];"
      },
      "id": "bug-hunt-shape",
      "name": "Shape Result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -40,
        0
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $json }}",
        "options": {}
      },
      "id": "bug-hunt-response",
      "name": "Respond to MCP Gateway",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.4,
      "position": [
        260,
        0
      ]
    }
  ],
