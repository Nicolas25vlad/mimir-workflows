{
  "name": "Mimir · Bug Hunt",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "mimir/bug-hunt",
        "authentication": "headerAuth",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "bug-hunt-webhook",
      "name": "Mimir Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [
        -720,
        0
      ],
      "webhookId": "mimir-bug-hunt",
      "credentials": {
        "httpHeaderAuth": {
          "id": "MIMIR_WEBHOOK_AUTH",
          "name": "Mimir Webhook Auth"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://repo-scanner:8790/scan",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify({ repository: $('Mimir Webhook').item.json.body.repository, ref: $('Mimir Webhook').item.json.body.ref ?? 'main' }) }}",
        "options": {
          "timeout": 120000
        }
      },
      "id": "bug-hunt-scanner",
      "name": "Scan Repository",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -440,
        0
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "MIMIR_SCANNER_AUTH",
          "name": "Mimir Scanner Auth"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const scan = $json;\nconst input = $('Mimir Webhook').item.json.body ?? {};\nconst order = { low: 0, medium: 1, high: 2, critical: 3 };\nconst minimum = input.minimum_severity ?? 'medium';\nconst findings = (scan.findings ?? []).filter(\n  (finding) => (order[finding.severity] ?? 0) >= (order[minimum] ?? 1)\n);\n\nreturn [{\n  json: {\n    status: 'completed',\n    workflow: 'bug-hunt',\n    run_id: String($execution.id),\n    contract_version: 2,\n    repository: scan.repository,\n    requested_ref: scan.requested_ref,\n    commit: scan.commit,\n    summary: {\n      ...scan.findings_summary,\n      returned_findings: findings.length,\n      analyzed_files: scan.inventory?.analyzed_files ?? 0,\n      analyzed_bytes: scan.inventory?.analyzed_bytes ?? 0,\n      truncated: scan.inventory?.truncated ?? false\n    },\n    findings: findings.slice(0, 100),\n    hotspots: (scan.hotspots ?? []).slice(0, 15),\n    largest_files: (scan.largest_files ?? []).slice(0, 15),\n    languages: scan.languages ?? []\n  }\n}];"
      },
      "id": "bug-hunt-shape",
      "name": "Shape Result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -140,
        0
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $json }}",
        "options": {}
      },
      "id": "bug-hunt-response",
      "name": "Respond to MCP Gateway",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.4,
      "position": [
        160,
        0
      ]
    }
  ],
  "connections": {
    "Mimir Webhook": {
      "main": [
        [
          {
            "node": "Scan Repository",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Scan Repository": {
      "main": [
        [
          {
            "node": "Shape Result",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Shape Result": {
      "main": [
        [
          {
            "node": "Respond to MCP Gateway",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "pinData": {},
  "settings": {
    "executionOrder": "v1"
  },
